{
  "id": null,
  "uid": "todo-overview",
  "title": "Todo Summary Assistant - Overview",
  "tags": [
    "todo",
    "spring-boot",
    "docker"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
