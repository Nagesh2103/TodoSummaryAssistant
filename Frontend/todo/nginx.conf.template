# Rendered by the nginx image entrypoint (envsubst) -> /etc/nginx/conf.d/default.conf
# Runtime variables: BACKEND_URL (e.g. http://backend:8080), DNS_RESOLVER (Docker DNS = 127.0.0.11)
server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # Resolve the backend at request time so nginx starts even if the backend is
    # briefly down/restarting (it would otherwise crash on an unresolvable upstream).
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml image/svg+xml;
    gzip_min_length 1024;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # REST API -> Spring Boot backend (same origin for the browser => no CORS needed)
    location /api/ {
        set $backend "${BACKEND_URL}";
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;   # /summarize calls Cohere + Slack
    }

    # Health endpoint used by the pipeline's post-deploy check and uptime monitors.
    # Only the aggregated status is exposed ({"status":"UP"}); no other actuator endpoint is public.
    location = /healthz {
        access_log off;
        set $backend "${BACKEND_URL}";
        rewrite ^ /actuator/health break;
        proxy_pass $backend;
    }

    # Hashed static assets can be cached aggressively
    location /static/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # React single-page app fallback
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        try_files $uri /index.html;
    }
}
