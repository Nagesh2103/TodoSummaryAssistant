# =====================================================================
# Copy to .env for local runs (docker compose). NEVER commit a real .env.
# In production these values come from SSM Parameter Store / Secrets
# Manager (see aws/aws-setup.md) - not from a file.
# =====================================================================

# ---- Backend (Spring Boot) -------------------------------------------
# JDBC URL. Local docker compose sets it automatically; RDS example:
# jdbc:mysql://<rds-endpoint>:3306/todo_db?sslMode=REQUIRED
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/todo_db?createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change_me
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SERVER_PORT=8080
# Comma separated; only needed when the UI is served from another origin than the API
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Secrets (blank is allowed: the app starts, /summarize then returns an error)
COHERE_API_KEY=your_cohere_api_key_here
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
# JVM flags
JAVA_OPTS=-XX:MaxRAMPercentage=70 -XX:+ExitOnOutOfMemoryError

# ---- Frontend (React / nginx) ----------------------------------------
# Build-time. Leave unset => relative "/api" (proxied by nginx or the CRA dev proxy).
# REACT_APP_API_BASE_URL=http://localhost:8080/api
# Runtime (nginx container): where /api is proxied to
BACKEND_URL=http://backend:8080

# ---- Local docker-compose only ---------------------------------------
MYSQL_ROOT_PASSWORD=change_me
GRAFANA_ADMIN_PASSWORD=change_me

# ---- CI/CD (GitHub repository secrets, NOT stored in this file) ------
# AWS_ROLE_ARN      IAM role assumed through GitHub OIDC      (terraform output github_role_arn)
# DEPLOY_BUCKET     S3 bucket for deploy bundles              (terraform output deploy_bucket)
# EC2_INSTANCE_ID   target instance for SSM Run Command       (terraform output instance_id)
# APP_URL           public URL used by the smoke test         (terraform output app_url)
# GitHub variable:  AWS_REGION (default ap-south-1)
